# Credential provider: env | percepxion | vault | aws | cyberark (default: env)
SLC_CREDENTIAL_PROVIDER=env

# Per-device credentials (replace SLC9000_DC_A with your device_id uppercased, hyphens -> underscores)
SLC_SLC9000_DC_A_IP=192.168.1.100
SLC_SLC9000_DC_A_USERNAME=admin
SLC_SLC9000_DC_A_PASSWORD=changeme

# Global fallback (single-device setups)
SLC_DEFAULT_IP=192.168.1.100
SLC_USERNAME=admin
SLC_PASSWORD=changeme

# Optional tuning
SLC_REQUEST_TIMEOUT=30
SLC_API_PATH_PREFIX=/api/v2
SLC_VERIFY_SSL=false
# SLC_URL_SCHEME=https  # Change to http only for local test servers (e.g. pytest-httpserver)

# Percepxion provider (only if SLC_CREDENTIAL_PROVIDER=percepxion)
PERCEPXION_API_URL=https://api.percepxion.ai
PERCEPXION_USERNAME=your@email.com
PERCEPXION_PASSWORD=yourpassword

# HashiCorp Vault provider (only if SLC_CREDENTIAL_PROVIDER=vault)
VAULT_ADDR=https://vault.example.com
VAULT_TOKEN=hvs.yourtoken

# AWS provider uses standard AWS credential chain (env vars, IAM role, ~/.aws/config)
# AWS_DEFAULT_REGION=us-east-1

# CyberArk CCP provider (only if SLC_CREDENTIAL_PROVIDER=cyberark)
# Uses the Central Credential Provider (CCP) REST API.
# AppID-only (no client cert): only CYBERARK_URL, CYBERARK_APP_ID, CYBERARK_SAFE required.
# mTLS: set CYBERARK_CERT_PATH + CYBERARK_KEY_PATH and mTLS is enabled automatically.
CYBERARK_URL=https://cyberark.example.com
CYBERARK_APP_ID=SLC-MCP-Server
CYBERARK_SAFE=SLC-Devices
# CYBERARK_CERT_PATH=/path/to/client.pem   # optional, enables mTLS when set
# CYBERARK_KEY_PATH=/path/to/client-key.pem
